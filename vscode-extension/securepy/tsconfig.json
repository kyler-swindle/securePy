{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "outDir": "out",
    "lib": ["ES2022"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "types": ["node", "vscode"],
    "moduleResolution": "node16"
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "out",
    ".vscode-test",
    "src/test"
  ]
}